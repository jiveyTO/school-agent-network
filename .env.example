# Copy to .env and fill in values. Never commit .env.
SCHOOL_AGENT_API_KEY=
SCHOOL_AGENT_MODEL=
# Brief 022 model routing. Extraction and the evening check run on the
# fast model first and escalate to SCHOOL_AGENT_MODEL (Spark) only on a
# failure signal. Set SCHOOL_AGENT_MODEL_ROUTING=spark-only to put every
# call back on SCHOOL_AGENT_MODEL. Defaults: ember-first, muse-ember-1.0.
# SCHOOL_AGENT_MODEL_ROUTING=ember-first
# SCHOOL_AGENT_FAST_MODEL=muse-ember-1.0
SCHOOL_AGENT_API_URL=
PORT=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_BASE_URL=
# Brief 041 recovery email (Resend). Both are required for the
# "Email me a recovery link" entry point to appear and send.
RESEND_API_KEY=
RESEND_FROM=
